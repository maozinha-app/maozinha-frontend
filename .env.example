# =====================================================================
# Mãozinha — variáveis do Docker Compose
# Copie para ".env" (cp .env.example .env) e troque TODOS os valores TROQUE_*.
# O arquivo .env NÃO deve ser commitado (já está no .gitignore).
# =====================================================================

# --- Localização do backend -----------------------------------------
# Caminho (relativo a esta pasta ou absoluto) do clone do repositório maozinha-backend.
# Padrão: os dois repositórios clonados lado a lado na mesma pasta.
BACKEND_DIR=../maozinha-backend

# --- PostgreSQL -------------------------------------------------------
# Nome do banco criado na primeira subida
POSTGRES_DB=maozinha
# Superusuário administrativo do container (usado só para criar o banco e os roles)
POSTGRES_USER=postgres
# Senha do superusuário
POSTGRES_PASSWORD=TROQUE_senha_admin_postgres

# Senha do role "maozinha_app", usado pelo backend para se conectar ao banco
DB_APP_PASSWORD=TROQUE_senha_app_maozinha

# ATENÇÃO: POSTGRES_* e DB_APP_PASSWORD só são aplicados na PRIMEIRA subida
# (volume vazio). Alterar depois não muda as senhas já gravadas — veja DOCKER.md.

# --- Backend (Spring Boot) --------------------------------------------
# Segredo para assinar os JWT. Mínimo de 32 caracteres (HS256).
# Gere um com: openssl rand -base64 48
JWT_SECRET=TROQUE_por_um_segredo_aleatorio_com_pelo_menos_32_caracteres

# Conta Gmail usada para enviar o e-mail de recuperação de senha.
# MAIL_USERNAME é OBRIGATÓRIO: o backend não inicia sem um e-mail em formato válido.
# Com o valor de exemplo abaixo a aplicação funciona, mas o "esqueci minha senha"
# não consegue enviar e-mail. Para enviar de verdade, use uma conta Gmail real e,
# em MAIL_PASSWORD, uma "senha de app" do Google (não a senha da conta).
MAIL_USERNAME=nao-configurado@example.com
MAIL_PASSWORD=

# --- Portas no computador (host) --------------------------------------
# Frontend no navegador: http://localhost:3000
FRONTEND_PORT=3000
# API direta (opcional): http://localhost:8080/api
BACKEND_PORT=8080
# PostgreSQL para DBeaver/pgAdmin: localhost:5432
POSTGRES_PORT=5432
